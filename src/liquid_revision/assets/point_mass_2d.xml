<mujoco model="point_mass_2d_tracking">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.01" integrator="RK4" gravity="0 0 0"/>
  <default>
    <joint damping="0.08" armature="0.002" limited="true"/>
    <geom friction="0.2 0.01 0.001"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>
  <worldbody>
    <light name="top" pos="0 0 4" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" pos="0 0 -0.03" size="2.2 2.2 0.05" rgba="0.94 0.94 0.94 1"/>
    <geom name="x_axis" type="box" pos="0 -2.0 0" size="2.0 0.006 0.006" rgba="0.25 0.25 0.25 1" contype="0" conaffinity="0"/>
    <geom name="y_axis" type="box" pos="-2.0 0 0" size="0.006 2.0 0.006" rgba="0.25 0.25 0.25 1" contype="0" conaffinity="0"/>
    <body name="tracker" pos="0 0 0.04">
      <joint name="slide_x" type="slide" axis="1 0 0" range="-2 2"/>
      <joint name="slide_y" type="slide" axis="0 1 0" range="-2 2"/>
      <geom name="tracker_geom" type="sphere" size="0.045" mass="0.20" rgba="0.10 0.35 0.85 1"/>
      <site name="tracker_site" type="sphere" size="0.055" rgba="0.10 0.35 0.85 0.25"/>
    </body>
    <site name="target" type="sphere" pos="0 0 0.04" size="0.055" rgba="0.95 0.25 0.10 0.70"/>
  </worldbody>
  <actuator>
    <motor name="motor_x" joint="slide_x" gear="1"/>
    <motor name="motor_y" joint="slide_y" gear="1"/>
  </actuator>
</mujoco>

